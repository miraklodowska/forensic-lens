{
  "$comment": "Runtime detection recipe. Fusion constants are fitted by tools/eval/finalize_v2.py against a 3,559-image public corpus; see docs/EVALUATION.md. The size gate is multiplicative and bounded in [0, cfMax] so it can discount the fingerprint detector's vote but never invert it. executionProviders is 'wasm' for both models, verified live in Chrome 136: ONNX Runtime's WebGPU provider blocks the offscreen document's thread synchronously at 100% CPU and never returns, and because the block is synchronous no timeout can recover it. WebGPU also mis-executes this build's INT8 operators, returning a constant for every input.",
  "schemaVersion": 3,
  "models": [
    {
      "id": "community-forensics-vit",
      "role": "cf",
      "file": "cf-vit.onnx",
      "input": {
        "name": "pixel_values",
        "size": 384,
        "layout": "nchw",
        "channelOrder": "rgb",
        "normalize": {
          "mean": [
            0.48145466,
            0.4578275,
            0.40821073
          ],
          "std": [
            0.26862954,
            0.26130258,
            0.27577711
          ]
        }
      },
      "output": {
        "name": "logits",
        "kind": "single-logit-sigmoid"
      },
      "views": [
        {
          "id": "off440",
          "kind": "scale",
          "shortestEdge": 440,
          "crop": 384
        },
        {
          "id": "s768",
          "kind": "scale",
          "shortestEdge": 768,
          "crop": 384,
          "maxUpscale": 2
        },
        {
          "id": "nc",
          "kind": "native",
          "position": "center",
          "crop": 384
        }
      ],
      "aggregate": "mean",
      "executionProviders": [
        "wasm"
      ]
    },
    {
      "id": "siglip-ai-vs-human",
      "role": "sg",
      "file": "siglip-detector-fp32.onnx",
      "input": {
        "name": "pixel_values",
        "size": 224,
        "layout": "nchw",
        "channelOrder": "rgb",
        "normalize": {
          "mean": [
            0.5,
            0.5,
            0.5
          ],
          "std": [
            0.5,
            0.5,
            0.5
          ]
        }
      },
      "output": {
        "name": "logits",
        "kind": "two-logit-softmax",
        "positiveIndex": 0
      },
      "views": [
        {
          "id": "sq",
          "kind": "squash",
          "size": 224
        },
        {
          "id": "ar",
          "kind": "scale",
          "shortestEdge": 224,
          "crop": 224
        },
        {
          "id": "nc",
          "kind": "native",
          "position": "center",
          "crop": 224
        }
      ],
      "aggregate": "mean",
      "executionProviders": [
        "wasm"
      ]
    }
  ],
  "fusion": {
    "kind": "size-gated-linear",
    "weights": {
      "cfMax": 0.2239776631419307,
      "sg": 0.1601007688236165
    },
    "gate": {
      "a": 3.0,
      "t": -0.5
    },
    "intercept": 0.8719722860459667,
    "thresholdOffset": 0.6190392084062236,
    "referenceEdge": 384
  }
}